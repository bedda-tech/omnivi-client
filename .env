# Omnivi Client — Vite environment variables
# Run `npm run deploy:contracts` in omnivi-server to auto-populate the addresses below.

# Default to loopback. This used to pin a LAN address (ws://192.168.68.62:8000)
# from whichever machine last edited it; DHCP moved that lease and every client
# built from this repo then failed to reach the server with
# ERR_CONNECTION_REFUSED — no room join, no leaderboard, no game. Override it
# locally (.env.local, git-ignored) when serving other devices on the LAN.
VITE_SERVER_URL=ws://localhost:8000

# Filled in by deploy script after contract deployment to Base Sepolia:
VITE_GAME_VAULT_ADDRESS=
VITE_VI_TOKEN_ADDRESS=
